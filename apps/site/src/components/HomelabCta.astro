---
import { Icon } from "astro-icon/components";
import AreaChart from "./common/AreaChart.astro";
import { guests } from "./homelab/data";

const card = "rounded-xl border border-border bg-card overflow-hidden";
const brand =
  "grayscale transition-[filter] duration-200 group-hover:grayscale-0";

const gauges = [
  { label: "CPU", fill: "38%" },
  { label: "RAM", fill: "64%" },
  { label: "ZFS", fill: "52%" },
];

const edge = ["wireguard", "caddy"];

const containers = [
  { icon: "grafana", name: "Grafana" },
  { icon: "tinyauth", name: "TinyAuth" },
  { icon: "blocky", name: "Blocky" },
];
---

<a
  href="/homelab"
  aria-label="Voir le homelab"
  class="group relative mt-12 flex w-full max-w-3xl flex-col justify-center gap-4 overflow-hidden bg-foreground p-6 outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background min-[672px]:rounded-2xl"
>
  <div class="relative z-10 flex max-w-44 flex-col gap-4 sm:max-w-none">
    <div>
      <h3 class="font-semibold">Homelab</h3>
      <p class="text-muted">Proxmox, entièrement décrit en code</p>
    </div>
    <span class="inline-flex items-center gap-1.5 text-sm text-muted">
      Voir
      <Icon
        name="right-arrow"
        class="size-3.5 transition-transform group-hover:translate-x-px"
      />
    </span>
  </div>

  <div
    class="pointer-events-none absolute -bottom-4 -right-32 flex sm:-right-6 items-end gap-1"
    aria-hidden="true"
  >
    <div class="flex w-32 flex-col gap-1">
      <div class:list={[card, "flex flex-col gap-3 p-3"]}>
        <div class="flex items-start justify-between">
          <Icon name="proxmox" class:list={["size-5", brand]} />
          <span class="mt-0.5 block size-1.5 rounded-full bg-secondary"></span>
        </div>
        <div class="flex flex-col gap-1">
          {
            gauges.map((gauge) => (
              <div class="flex items-center gap-1">
                <span class="w-6 shrink-0 text-[0.6rem] leading-none text-muted">
                  {gauge.label}
                </span>
                <span class="block h-1 flex-1 overflow-hidden rounded-full bg-muted/20">
                  <span
                    class="block h-full rounded-full bg-secondary"
                    style={`width:${gauge.fill}`}
                  />
                </span>
              </div>
            ))
          }
        </div>
      </div>
      <div class="flex gap-1">
        {
          edge.map((icon) => (
            <div
              class:list={[
                card,
                "flex h-10 flex-1 items-center justify-center",
              ]}
            >
              <Icon name={icon} class:list={["size-5", brand]} />
            </div>
          ))
        }
      </div>
    </div>

    <div class="flex w-44 flex-col gap-1">
      <div class:list={[card, "h-12"]}>
        <AreaChart />
      </div>
      <div class={card}>
        <div class="flex h-9 items-center gap-2 border-b border-border px-3">
          <Icon name="terraform" class:list={["size-4 shrink-0", brand]} />
          <span class="text-[0.7rem] leading-none">
            <span class="font-medium">{guests.length}</span>{" "}
            <span class="text-muted">conteneurs</span>
          </span>
        </div>
        <ul class="divide-y divide-border">
          {
            containers.map((service) => (
              <li class="flex h-6 items-center gap-2 px-3">
                <Icon
                  name={service.icon}
                  class:list={["size-3.5 shrink-0", brand]}
                />
                <span class="truncate text-[0.65rem] leading-none text-muted">
                  {service.name}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</a>
