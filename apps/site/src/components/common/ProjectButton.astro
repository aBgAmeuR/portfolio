---
import { Icon } from "astro-icon/components";

export interface Props {
  href: string;
  project: string;
}

const href: string = Astro.props.href;
const project: string = Astro.props.project;
---

<a
  href={href}
  target="_blank"
  rel="noreferrer noopener"
  class="pressable pressable-tint inline-flex items-center gap-1.5 h-7 -my-2 px-2 -mr-1.5 text-xs font-medium text-muted no-underline rounded-md outline-none hover:text-primary hover:bg-foreground focus-visible:ring-2 focus-visible:ring-ring ring-offset-card focus-visible:ring-offset-2"
  aria-label={`Voir le code de ${project} sur GitHub - s'ouvre dans un nouvel onglet`}
>
  <!-- <Icon name="github" class="pointer-events-none size-3.5 shrink-0" aria-hidden="true" /> -->
  GitHub
</a>
