---
import TechnologyBadge from "./common/TechnologyBadge.astro";
import SocialLink from "./common/SocialLink.astro";
import SectionTitle from "./SectionTitle.astro";
---

<section class="px-6 flex flex-col gap-2" aria-labelledby="about-title">
  <SectionTitle title="À propos" id="about-title" />
  <p class="leading-7 text-muted mb-2">
    Je suis en Cycle Mastère (M1-M2) Développement Full Stack à{" "}
    <TechnologyBadge name="Sup de Vinci" icon="sdv" />{" "}
    Rennes et je poursuis mon parcours en alternance chez{" "}
    <TechnologyBadge name="Orange" icon="orange" />. Full-stack par passion. Je
    conçois, développe et self-host.
  </p>
  <p class="leading-7 text-muted mb-2">
    Je travaille principalement en{" "}
    <TechnologyBadge name="TypeScript" icon="typescript" /> avec{" "}
    <TechnologyBadge name="React" icon="react" /> ou{" "}
    <TechnologyBadge name="Angular" icon="angular" /> côté front, et avec{" "}
    <TechnologyBadge name="Java" icon="java" /> ou{" "}
    <TechnologyBadge name="Rust" icon="rust" /> côté back. J'accorde beaucoup d'importance
    à la lisibilité du code, aux détails d'interface et aux ressentis utilisateurs.
  </p>
  <div
    class="flex flex-wrap gap-2"
    role="group"
    aria-label="Liens sociaux et de contact"
  >
    <SocialLink
      href="https://github.com/aBgAmeuR"
      icon="github"
      text="@aBgAmeuR"
      title="GitHub"
    />
    <SocialLink
      href="mailto:antoine.josset35@gmail.com"
      icon="email"
      text="antoine.josset35@gmail.com"
      title="Mail"
    />
    <SocialLink
      href="https://open.spotify.com/user/flps7duvtycn9yto85qwxpqtp"
      icon="spotify-duotone"
      text="Antoine"
      title="Spotify"
    />
  </div>
</section>
