---
import Ico from "./Ico.astro";

export interface Props {
  title: string;
  tag: string;
  logo?: string;
  icon?: string;
  n?: number;
  slot?: string;
}

const { title, tag, logo, icon, n } = Astro.props;
---

<div class="inset">
  <div class="top">
    <Ico logo={logo} icon={icon} small />
    <p class="tag">
      {n === undefined ? tag : <span class="wire-label"><span class="n">{n}</span>{tag}</span>}
    </p>
  </div>
  <div>
    <h4>{title}</h4>
    <slot />
  </div>
</div>
